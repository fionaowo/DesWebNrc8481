import os
import secrets
from itertools import count

from fastapi import Depends, FastAPI, Header, HTTPException
from pydantic import BaseModel

BACKEND_SHARED_SECRET = os.getenv("BACKEND_SHARED_SECRET")
if not BACKEND_SHARED_SECRET:
    raise RuntimeError("BACKEND_SHARED_SECRET no está configurado")


async def only_from_gateway(
    x_gateway_secret: str = Header(default=""),
    x_authenticated_client: str = Header(default=""),
) -> str:
    """Solo acepta tráfico que venga del gateway."""
    ok = secrets.compare_digest(x_gateway_secret.encode(), BACKEND_SHARED_SECRET.encode())
    if not ok or not x_authenticated_client:
        raise HTTPException(status_code=403, detail="Acceso directo no permitido")
    return x_authenticated_client


app = FastAPI(title="Backend", dependencies=[Depends(only_from_gateway)])

# Datos en memoria (reemplazar por una base de datos real)
products = {1: {"id": 1, "name": "Teclado", "price": 25000}}
orders: dict[int, dict] = {}
_product_ids = count(2)
_order_ids = count(1)


class ProductIn(BaseModel):
    name: str
    price: float


class OrderIn(BaseModel):
    product_id: int
    quantity: int = 1


@app.get("/health")
async def health():
    return {"status": "ok", "service": "backend"}


@app.get("/products")
async def list_products():
    return list(products.values())


@app.post("/products", status_code=201)
async def create_product(item: ProductIn):
    pid = next(_product_ids)
    products[pid] = {"id": pid, **item.model_dump()}
    return products[pid]


@app.get("/products/{product_id}")
async def get_product(product_id: int):
    if product_id not in products:
        raise HTTPException(status_code=404, detail="Producto no encontrado")
    return products[product_id]


@app.delete("/products/{product_id}", status_code=204)
async def delete_product(product_id: int):
    if products.pop(product_id, None) is None:
        raise HTTPException(status_code=404, detail="Producto no encontrado")


@app.get("/orders")
async def list_orders(client: str = Depends(only_from_gateway)):
    return [o for o in orders.values() if o["client"] == client]


@app.post("/orders", status_code=201)
async def create_order(item: OrderIn, client: str = Depends(only_from_gateway)):
    if item.product_id not in products:
        raise HTTPException(status_code=404, detail="Producto no encontrado")
    oid = next(_order_ids)
    orders[oid] = {"id": oid, "client": client, **item.model_dump()}
    return orders[oid]
