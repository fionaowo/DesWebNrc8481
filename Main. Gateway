import os
import secrets
import time

import httpx
from fastapi import Depends, FastAPI, HTTPException, Request, Response
from fastapi.security import HTTPAuthorizationCredentials, HTTPBearer

VAULT_ADDR = os.getenv(
    "VAULT_ADDR", "http://localhost:8200"
)

VAULT_TOKEN = os.getenv("VAULT_TOKEN")  # en dev: dev-only-token

if not VAULT_TOKEN:
    raise RuntimeError("VAULT_TOKEN no está configurado")

BACKEND_URL = os.getenv("BACKEND_URL", "http://localhost:9000")

# Los secretos se cachean unos segundos para no golpear Vault en cada petición
SECRETS_TTL = 30
_cache: dict = {"value": None, "expires": 0.0}

app = FastAPI(title="API Gateway")
security = HTTPBearer(auto_error=False)


async def get_gateway_secrets() -> dict:
    """Lee client_token y backend_shared_secret desde Vault (KV v2)."""
    if _cache["value"] and _cache["expires"] > time.monotonic():
        return _cache["value"]

    url = f"{VAULT_ADDR}/v1/secret/data/gateway"
    headers = {"X-Vault-Token": VAULT_TOKEN}
    try:
        async with httpx.AsyncClient(timeout=5.0) as client:
            response = await client.get(url, headers=headers)
    except httpx.RequestError as exc:
        raise HTTPException(status_code=500, detail=f"No fue posible conectar con Vault: {exc}")

    if response.status_code != 200:
        raise HTTPException(
            status_code=500,
            detail=f"No fue posible acceder a Vault: {response.status_code}",
        )

    data = response.json()["data"]["data"]  # KV v2 anida data dentro de data
    _cache["value"] = data
    _cache["expires"] = time.monotonic() + SECRETS_TTL
    return data


async def authenticate_client(
    credentials: HTTPAuthorizationCredentials = Depends(security),
):
    if credentials is None:
        raise HTTPException(status_code=401, detail="Bearer token requerido")

    vault_secrets = await get_gateway_secrets()  # client_token, backend_shared_secret
    expected_token = vault_secrets["client_token"]
    received_token = credentials.credentials

    # compare_digest evita ataques de temporización
    valid = secrets.compare_digest(received_token.encode(), expected_token.encode())
    if not valid:
        raise HTTPException(status_code=401, detail="Token inválido")

    return {
        "client_id": "student-client",  # identificación del cliente autenticado
        "backend_secret": vault_secrets["backend_shared_secret"],
    }


@app.get("/health")
async def health():
    return {"status": "ok"}


# Headers que no deben reenviarse tal cual al backend
_SKIP_REQUEST_HEADERS = {
    "host", "content-length", "authorization", "connection",
    "x-gateway-secret", "x-authenticated-client",  # evita que el cliente los falsifique
}


@app.api_route(
    "/api/{path:path}",  # products, health, orders
    methods=["GET", "POST", "PUT", "PATCH", "DELETE"],
)
async def proxy(
    path: str,
    request: Request,
    auth=Depends(authenticate_client),
):
    # http://localhost:8000/api/products -> http://localhost:9000/products
    target_url = f"{BACKEND_URL}/{path}"
    body = await request.body()

    headers = {
        k: v for k, v in request.headers.items() if k.lower() not in _SKIP_REQUEST_HEADERS
    }
    headers["X-Gateway-Secret"] = auth["backend_secret"]
    headers["X-Authenticated-Client"] = auth["client_id"]

    try:
        async with httpx.AsyncClient(timeout=10.0) as client:
            upstream = await client.request(
                request.method,
                target_url,
                params=request.query_params,
                content=body,
                headers=headers,
            )
    except httpx.RequestError:
        raise HTTPException(status_code=502, detail="El backend no responde")

    return Response(
        content=upstream.content,
        status_code=upstream.status_code,
        media_type=upstream.headers.get("content-type"),
    )
